#include<iostream>
int main()
{
    int a[10],temp;
    std:: cout<<"Enter the elements for the array: ";
    for(int i=0;i<10;i++)
    {
        std:: cin>>a[i];
    }
    for(int i=0;i<9;i++)
    {
        for(int j=i+1;j<10;j++)
        {
            if(a[i]>a[j])
            {
                temp=a[i];
                a[i]=a[j];
                a[j]=temp;
            }
        }
    }
    std:: cout<<"\n\nThe sorted array is here: \n";
    for(int i=0;i<10;i++)
    {
        std:: cout<<a[i]<<" ";
    }
    return 0;
}
