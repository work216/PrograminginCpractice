#include<stdio.h>
#include<stdlib.h>

struct node
{
    int data;
    struct node* next;
};

void linkedlistreversal(struct node * ptr)
{
    while(ptr!=NULL)
    {
        printf("\nElement: %d ",ptr->data);
        ptr = ptr -> next;
    }
}

int main()
{
    struct node* head;
    struct node*first;
    struct node* second;
    struct node* third;
    struct node* fourth;
    
    head= (struct node*)malloc(sizeof(struct node));
    first= (struct node*)malloc(sizeof(struct node));
    second= (struct node*)malloc(sizeof(struct node));
    third= (struct node*)malloc(sizeof(struct node));
    fourth= (struct node*)malloc(sizeof(struct node));
    
    head-> data =7;
    head-> next =first;
    
    first->data =3;
    first->next=second;
    
    second->data=45;
    second->next=third;
    
    third->data=55;
    third->next=fourth;
    
    fourth->data=44;
    fourth->next=NULL;
    
    linkedlistreversal(head);
    
    return 0;
}
