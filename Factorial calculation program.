#include<iostream>
int main()
{
    int factorial=1,n;
    std:: cout<<"Enter the number whose factorial you want to find: ";
    std:: cin>>n;
    for(int i=1;i<=n;i++)
    {
        factorial=factorial*i;
    }
    std:: cout<<"\nThe factorial of the given number is: "<<factorial<<".";
    return 0;
}
