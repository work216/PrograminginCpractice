#include<iostream>
int main()
{
    int a[10],max[0];
    std:: cout<<"Enter the 10 elements of array: ";
    for(int i=0;i<10;i++)
    {
        std:: cin>>a[i];
    }
    max[0]=a[0];
    for(int i=0;i<10;i++)
    {
        if(max[0]<a[i])
        {
            max[0]=a[i];
        }
    }
    std:: cout<<"\nThe largest number in an array : "<<max[0];
    return 0;
}
