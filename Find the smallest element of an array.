#include<iostream>
int main()
{
    int a[10],min[0];
    std:: cout<<"Enter the 10 elements of array: ";
    for(int i=0;i<10;i++)
    {
        std:: cin>>a[i];
    }
    min[0]=a[0];
    for(int i=0;i<10;i++)
    {
        if(min[0]>a[i])
        {
            min[0]=a[i];
        }
    }
    std:: cout<<"\nThe smallest number in an array : "<<min[0];
    return 0;
}
